# Copy to .env (or export these) and adjust. Values shown are the defaults.

# Optional. AI drafting only — the manual mermaid editor, the live renderer,
# versions and every export work with no key at all, and only the generate and
# revise routes return 503 without one.
ANTHROPIC_API_KEY=

# Required for any non-loopback bind: the app refuses to start on HOST=0.0.0.0
# without it. Optional (and off) when bound to 127.0.0.1.
AUTH_TOKEN=

# Bind address. Leave on loopback unless you front the app with a TLS proxy.
HOST=127.0.0.1

# HTTP port.
PORT=6183

# Text model used to draft and revise diagram sources.
SKETCHFORGE_MODEL=claude-sonnet-5

# Directory holding data/sketches/<slug>/ and the deleted-sketch trash.
SKETCHFORGE_DATA=./data

# Age in days at which trashed sketches are purged on startup.
SKETCHFORGE_TRASH_DAYS=7

# 1 swaps in the deterministic offline drafter (demo/tests) — no key, no network.
SKETCHFORGE_FAKE=
